{
  "name": "trello-clone",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --experimental-strip-types --test src/services/__tests__/localBoardStorage.test.ts src/utils/__tests__/cardSearch.test.ts",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "async-validator": "^4.2.5",
    "axios": "^1.20.0",
    "change-case": "^5.4.4",
    "drauu": "^1.0.0",
    "focus-trap": "^7.8.0",
    "fuse.js": "^7.5.0",
    "idb-keyval": "^6.3.0",
    "jwt-decode": "^4.0.0",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.3",
    "qrcode": "^1.5.4",
    "universal-cookie": "^8.1.2",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "postcss": "^8.5.29",
    "prettier": "3.9.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
